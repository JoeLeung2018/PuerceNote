# PuerceNote Configuration - Environment Variables

# ===== 基础配置 =====

# 应用名称和版本
APP_NAME=PuerceNote
APP_VERSION=1.0.0-beta

# 运行环境
ENVIRONMENT=development  # development, staging, production

# ===== 数据库 =====

DATABASE_URL=sqlite:./appflowy.db
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=30

# ===== 日志配置 =====

RUST_LOG=info,flowy_ai=debug,flowy_subscription=debug
LOG_LEVEL=info

# ===== vLLM + frpc 隧道配置 =====

# 本地vLLM代理地址（通过frpc隧道）
VLLM_PROXY_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=meta-llama/Llama-2-9b-hf

# 或者改用 Mistral 7B（推荐，推理速度更快）
# VLLM_MODEL=mistralai/Mistral-7B-v0.1

# GPU利用率配置
VLLM_GPU_MEMORY_UTILIZATION=0.9

# 量化方式（节省显存）
VLLM_LOAD_FORMAT=bitsandbytes

# frpc 隧道连接参数
FRPC_RETRY_INTERVAL=5000       # 连接重试间隔（毫秒）
FRPC_MAX_RETRIES=3             # 最多重试次数
FRPC_TIMEOUT=120               # 请求超时（秒）
FRPC_CONNECTION_POOL_SIZE=10   # 连接池大小

# ===== Token 配额配置 =====

# 按用户订阅计划的Token限额
PRO_MONTHLY_TOKEN_LIMIT=100000
TEAM_MONTHLY_TOKEN_LIMIT=500000

# 本地成本模型（用于计费追踪）
TOKEN_COST_PER_1M=0.0001  # 每百万token成本（美元），基于自建GPU折旧

# ===== Lemon Squeezy 支付配置 =====

# Lemon Squeezy API密钥
LEMON_SQUEEZY_API_KEY=your_api_key_here

# Lemon Squeezy Webhook签名密钥（用于验证webhook）
LEMON_SQUEEZY_WEBHOOK_SIGNATURE_SECRET=your_webhook_secret_here

# Lemon Squeezy Store ID（商店ID）
LEMON_SQUEEZY_STORE_ID=12345

# Lemon Squeezy 产品ID（在Lemon Squeezy后台获取）
LEMON_SQUEEZY_PRO_PRODUCT_ID=1
LEMON_SQUEEZY_PRO_VARIANT_ID=1
LEMON_SQUEEZY_TEAM_PRODUCT_ID=2
LEMON_SQUEEZY_TEAM_VARIANT_ID=2

# Lemon Squeezy Webhook回调地址
LEMON_SQUEEZY_WEBHOOK_URL=https://api.puercenote.com/api/webhooks/lemon-squeezy

# ===== Web3 / Polygon 配置 =====

# Polygon RPC 节点地址
# 测试网（Mumbai）
POLYGON_RPC_TESTNET=https://rpc-mumbai.maticvigil.com

# 主网
POLYGON_RPC_MAINNET=https://polygon-rpc.com

# 使用的网络（testnet 或 mainnet）
POLYGON_NETWORK=testnet  # development阶段用testnet

# 智能合约部署地址
PAYMENT_CONTRACT_ADDRESS_TESTNET=0x...
PAYMENT_CONTRACT_ADDRESS_MAINNET=0x...

# 接受的稳定币合约
USDC_CONTRACT_ADDRESS=0x...
USDT_CONTRACT_ADDRESS=0x...

# Polygon Gas配置
POLYGON_GAS_PRICE_GWEI=50

# WalletConnect Project ID（用于钱包连接）
WALLETCONNECT_PROJECT_ID=your_project_id_here

# ===== Web服务器配置 =====

# API服务器地址
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8080

# Webhook服务器端口
WEBHOOK_SERVER_PORT=8081

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://puercenote.com

# ===== 安全配置 =====

# JWT密钥（用于API认证）
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 会话超时时间（秒）
SESSION_TIMEOUT=86400  # 24小时

# ===== 邮件配置（可选） =====

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@puercenote.com
SMTP_PASSWORD=your_smtp_password

# 发送者邮箱
MAIL_FROM=noreply@puercenote.com
MAIL_FROM_NAME=PuerceNote

# ===== 存储配置 =====

# 本地文件存储路径
STORAGE_PATH=./storage

# 最大上传文件大小（字节）
MAX_UPLOAD_SIZE=104857600  # 100MB

# ===== 功能开关 =====

# AI功能开关
ENABLE_AI_FEATURES=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_PRIVACY_FILTER=true

# 支付功能开关
ENABLE_PAYMENTS=true
ENABLE_WEB3=true

# 开发功能
ENABLE_DEBUG_MODE=false
ENABLE_PROFILE_ENDPOINTS=false

# ===== 监控和分析 =====

# Sentry错误追踪（可选）
SENTRY_DSN=

# 应用性能监控（可选）
APM_ENABLED=false
APM_SERVER_URL=

# ===== 第三方集成 =====

# GitHub OAuth（可选，用于登录）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Analytics（可选）
GOOGLE_ANALYTICS_ID=

# ===== 开发环境特定配置 =====

# 仅在 ENVIRONMENT=development 时有效

# Mock支付（跳过真实支付过程）
MOCK_PAYMENTS=false

# 显示详细日志
VERBOSE_LOGGING=true

# 启用热重载（Rust）
CARGO_WATCH_ENABLED=true

# Flutter热重载
FLUTTER_HOT_RELOAD=true

# ===== 注意事项 =====

# 1. 不要在版本控制中提交实际的API密钥
# 2. 所有敏感信息应通过环境变量传入
# 3. 生产环境应使用强密钥和加密
# 4. 定期轮换API密钥和签名密钥
# 5. 在部署前测试所有配置

# ===== 快速参考 =====

# 开发环境启动：
# source .env.development
# cargo run --release

# 测试环境启动：
# source .env.staging
# cargo run --release

# 生产环境启动：
# source .env.production
# cargo run --release
